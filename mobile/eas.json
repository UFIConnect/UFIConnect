{
  "cli": {
    "version": ">= 24.10.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_ENV": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "APP_ENV": "preview"
      }
    },
    "production-android": {
      "extends": "production",
      "distribution": "store",
      "buildArtifactPaths": ["android/app/build/outputs/apk/release/*.apk"],
      "android": {
        "gradleCommand": ":app:bundleRelease :app:assembleRelease",
        "applicationArchivePath": "android/app/build/outputs/bundle/release/*.aab"
      }
    },
    "production": {
      "node": "24.21.0",
      "ios": {
        "buildConfiguration": "Release"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "APP_ENV": "production",
        "EXPO_NO_BUNDLE_SPLITTING": "1",
        "API_URL": "https://api.uficonnect.org"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6810521346"
      }
    }
  }
}
