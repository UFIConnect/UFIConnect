# ── Build stage ───────────────────────────────────────────────
FROM node:24-alpine AS base
WORKDIR /app

COPY backend/package*.json ./
RUN npm ci --omit=dev

COPY --chown=node:node backend/ ./
RUN mkdir -p /app/data && chown node:node /app/data
USER node

# ── Runtime ───────────────────────────────────────────────────
EXPOSE 3000
CMD ["node", "index.js"]
