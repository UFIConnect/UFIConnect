{
  "name": "pro-connect-mobile",
  "version": "0.1.0",
  "private": true,
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./native-vpn",
      "ios": {
        "exclude": ["@uficonnect/native-vpn"]
      }
    }
  },
  "main": "index.js",
  "engines": {
    "node": "^22.13.0 || >=24.3.0"
  },
  "scripts": {
    "eas-build-post-install": "node native-vpn/prepare-go.mjs",
    "test:vpn": "node --test native-vpn/controller.test.cjs native-vpn/plugin.test.cjs native-vpn/session.test.cjs native-vpn/prepare-go.test.mjs native-vpn/launch.test.cjs native-vpn/launchConnection.test.cjs native-vpn/action.test.cjs native-vpn/officialWireGuard.test.cjs",
    "postinstall": "node security/dependencyPatches.cjs",
    "audit:security": "node --test security/dependencyBackports.test.js && node security/dependencyAudit.cjs",
    "prepare:analytics": "node scripts/prepare-analytics.mjs",
    "prestart": "npm run prepare:analytics",
    "preandroid": "npm run prepare:analytics",
    "preios": "npm run prepare:analytics",
    "preweb": "npm run prepare:analytics",
    "preexport": "npm run prepare:analytics",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "export": "expo export --platform all",
    "doctor": "expo-doctor",
    "test:export": "node scripts/audit-export.mjs",
    "test:moderation": "node scripts/audit-moderation.mjs",
    "test:security": "node --test security/security.test.js security/dependencyCompatibility.test.js security/dependencyBackports.test.js security/accountDeletion.test.js security/moderation.test.js analytics/screenPolicy.test.js analytics/serviceMetrics.test.js && npm run test:vpn",
    "test:analytics": "node scripts/audit-analytics.mjs && node scripts/audit-preferences.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.19.2",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.2",
    "axios": "^1.5.0",
    "expo": "~57.0.27",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.3",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-modules-commonjs": "^7.29.7",
    "@babel/plugin-transform-react-jsx": "^7.29.7",
    "babel-preset-expo": "~57.0.12",
    "expo-doctor": "^1.20.4"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
