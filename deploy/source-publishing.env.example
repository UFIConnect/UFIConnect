# Provider setup worksheet — copy only actual provider-issued values.
# Keep OAuth credentials identical on API and pipeline; never send them to web.
# Do not apply this template's empty fields over configured production values.
API_BASE_URL=https://api.uficonnect.org
PUBLIC_API_URL=https://api.uficonnect.org
OAUTH_CALLBACK_BASE_URL=https://api.uficonnect.org

# https://api.uficonnect.org/auth/social/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# https://api.uficonnect.org/auth/social/instagram/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# https://api.uficonnect.org/auth/social/threads/callback
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
# https://api.uficonnect.org/auth/social/reddit/callback
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Existing approved legacy OAuth app only:
# https://api.uficonnect.org/auth/social/medium/callback
MEDIUM_CLIENT_ID=
MEDIUM_CLIENT_SECRET=
