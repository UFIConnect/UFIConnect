# ── Server ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Auth ─────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-secret

# Optional Auth0 login/API protection.
# Domain format: your-tenant.us.auth0.com (no https://)
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_ISSUER=

# ── Database (optional — omit to use in-memory mock data) ────
# Local:      DATABASE_URL=postgresql://user:password@localhost:5432/proconnect
# AWS RDS:    DATABASE_URL=postgresql://user:password@your-rds-host.rds.amazonaws.com:5432/proconnect
DATABASE_URL=

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins (leave empty to allow all)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5178,https://uficonnect.org,https://www.uficonnect.org,https://yosufkaka99-alt.github.io

# Public deployment targets
API_BASE_URL=https://api.uficonnect.org
FRONTEND_URL=https://uficonnect.org
WEB_OPTIMIZER_URL=https://uficonnect.org
WEB_OPTIMIZER_OFFICE_URL=https://yosufkaka99-alt.github.io/proconnect/office/
WEB_OPTIMIZER_API_URL=https://api.uficonnect.org

# Railway runtime
NODE_HEAP_MB=1024

# Optional Office Deploy Center manual dispatch.
# Use a fine-scoped GitHub token that can dispatch workflows for this repo.
GITHUB_DEPLOY_TOKEN=
GITHUB_DEPLOY_REPO=yosufkaka99-alt/proconnect
GITHUB_DEPLOY_REF=main
