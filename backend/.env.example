# ── Server ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Pipeline/api role split ──────────────────────────────────
# 'api' (default if unset) serves real user traffic and never fetches
# external sources on its own. 'pipeline' runs all the continuous
# background source-fetchers and writes to feed_posts_staging instead of
# feed_posts_cache — see uficonnect-pipeline in render.yaml and the
# SERVICE_ROLE gates throughout backend/index.js (startContinuousWorkers,
# computePersonalizedFeedPool, enqueueSourceRefresh, etc.). Leave unset for
# local dev — same single-process behavior as before this existed.
SERVICE_ROLE=

# ── Auth ─────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-secret
# Production requires a separate random 32-byte key encoded in base64.
# Keep the same persistent value on API and pipeline; never regenerate at startup.
OAUTH_TOKEN_ENCRYPTION_KEY=
# Required to access production Office administration endpoints.
OFFICE_TOKEN=
# Leave empty for direct connections. Configure only actual trusted proxy
# addresses/hops before production; arbitrary forwarded headers are not trusted.
TRUST_PROXY=

# Optional Auth0 login/API protection.
# Domain format: your-tenant.us.auth0.com (no https://)
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_ISSUER=

# ── Database (optional — omit to use in-memory mock data) ────
# Local:      DATABASE_URL=postgresql://user:password@localhost:5432/uficonnect
# AWS RDS:    DATABASE_URL=postgresql://user:password@your-rds-host.rds.amazonaws.com:5432/uficonnect
DATABASE_URL=
# Production defaults to verified TLS. On Render, configure the full external
# database URL and restrict its network allowlist to the service egress IPs.
# Development without an explicit mode permits a local PostgreSQL server.
DATABASE_SSL_MODE=
DATABASE_SSL_CA=
# Set true only with DATABASE_SSL_MODE=disable on a trusted private network.
DATABASE_ALLOW_PLAINTEXT_INTERNAL=false

# Optional read-failover target (see db.js: readQuery/initBackupDB). Only
# used by the two hot feed queries after repeated primary failures. The
# snapshot is API-only and bounded by age and rows; it is never a second
# production archive or write target.
DATABASE_URL_BACKUP=
BACKUP_FEED_RETENTION_DAYS=14
BACKUP_FEED_MAX_ROWS=40000
BACKUP_DB_LIMIT_MB=5120
BACKUP_DB_RESET_PCT=85

# Stripe billing. Resume Builder must use an active USD $149.94 recurring
# Price with interval=month and interval_count=6. New purchases use the
# preferred variable; existing subscriptions stay on the Price they bought.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_PRICE_ID_BUSINESS=
STRIPE_RESUME_BUILDER_PRICE_ID=
# Legacy fallback only; leave blank when the preferred variable is set.
STRIPE_PRICE_ID_RESUME_BUILDER=

# ── Content screening ───────────────────────────────────────────────────────
# Public/external feed items go through deterministic URL/spam checks in the
# pipeline. Member-created posts, comments, messages, and cross-posts receive
# a second OpenAI Moderations API check when OPENAI_API_KEY is present.
OPENAI_API_KEY=
# Office Live City explanations use this service's key when configured. The
# pipeline needs its own server-side setting for pipeline-agent AI replies.
# Without it, protected local diagnostic conversations remain available.
OFFICE_CHAT_OPENAI_MODEL=gpt-5-mini
CONTENT_SCREENING_OPENAI_MODEL=omni-moderation-latest
CONTENT_SCREENING_TIMEOUT_MS=8000
CONTENT_SCREENING_MAX_CONCURRENT=4
CONTENT_SCREENING_MAX_QUEUED=100
CONTENT_SUBMISSION_RATE_LIMIT=30

# Media Studio video generation uses the same OPENAI_API_KEY above. The
# selected OpenAI project must have access to the configured video model.
VIDEO_GENERATION_OPENAI_MODEL=sora-2
VIDEO_GENERATION_OPENAI_SECONDS=4
VIDEO_GENERATION_OPENAI_SIZE=720x1280
MEDIA_GENERATION_RATE_LIMIT=6
# Narrated videos with generated images and synchronized captions (4-300 sec).
# Requires the existing OPENAI_API_KEY for storyboards and Cloudinary storage.
# Use a production Shotstack key with v1; stage renders have a watermark.
# Shotstack AI assets cost credits even in stage. Do not paste keys in the UI.
SHOTSTACK_API_KEY=
SHOTSTACK_ENV=v1
# Optional long-form provider. It receives POST {prompt, durationSeconds,
# duration} and responds synchronously with {mediaUrl} or {url}. This app's
# existing OpenAI adapter uses 4, 8, or 12-second clips; this provider handles
# other requests up to 300 seconds. Durations above 300 are rejected.
# The built-in Shotstack adapter uses SHOTSTACK_API_KEY instead of this URL.
# Creatomate still needs a separate adapter.
# See docs/VIDEO-DURATION-AND-PROVIDERS.md for the narrated-video recommendation
# and OpenAI's September 24, 2026 Videos API shutdown notice.
VIDEO_GENERATION_API_URL=
VIDEO_GENERATION_API_KEY=

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins (leave empty to allow all)
ALLOWED_ORIGINS=http://localhost:5173

# Public pages allowed to embed the optional GA bridge. Use exact HTTPS origins
# in production. The bridge must be on a different origin from each frontend.
ANALYTICS_PARENT_ORIGINS=http://localhost:5173,http://localhost:8081

# ── Public URL bases used for OAuth redirects ────────────────────────────────
# Local:
API_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
# Production:
# API_BASE_URL=https://uficonnect-api-708r.onrender.com
# FRONTEND_URL=https://uficonnect.org

# ── Platform OAuth app credentials ───────────────────────────────────────────
# Add the callback URL shown by /auth/social/config to each provider app.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Separate from the OAuth pair above — a free, self-serve Data API v3 key
# (console.cloud.google.com > APIs & Services > Credentials, no app review
# needed). Without it, only source-hosted YouTube channel RSS is used.
# No unofficial API, extraction, or scraping fallback is allowed.
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
MEDIUM_CLIENT_ID=
MEDIUM_CLIENT_SECRET=
DRIBBBLE_CLIENT_ID=
DRIBBBLE_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
BEHANCE_CLIENT_ID=
BEHANCE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
BLUESKY_SIGNING_KEY=
BLUESKY_CLIENT_ID=
BLUESKY_CLIENT_SECRET=

# ── Office dashboard: Deploy Center ──────────────────────────────────────────
# Direct Render fallback for the Office Deploy Center. The preferred path uses
# OFFICE_GITHUB_TOKEN below to dispatch the verified GitHub Actions workflow;
# its hook URLs live in the protected GitHub environment rather than here.
RENDER_HOOK_API=
RENDER_HOOK_WEB=
RENDER_HOOK_OFFICE=
RENDER_HOOK_PIPELINE=
RENDER_API_KEY=
# Read-only managed recovery evidence in Office. IDs, not connection URLs.
RENDER_DATABASE_ID=
RENDER_BACKUP_DATABASE_ID=
RENDER_SERVICE_API_ID=
RENDER_SERVICE_WEB_ID=
RENDER_SERVICE_OFFICE_ID=
RENDER_SERVICE_PIPELINE_ID=
# Read-only, used for repo search/commits/issues (see GITHUB_HEADERS) —
# separate from AUTOFIX_GITHUB_TOKEN below, which needs write access.
GITHUB_TOKEN=

# ── Office dashboard: Autofix agent ──────────────────────────────────────────
# Detects a recurring server error from real usage, drafts a narrow fix, and
# — only when enabled — commits it via GitHub. The verified deployment
# workflow ships successful main commits and the agent reverts health
# regressions afterward. Off by default; see office/src Autofix view. Detection/logging
# always run regardless of AUTOFIX_ENABLED — only committing a fix is gated.
AUTOFIX_ENABLED=false
# A NEW, separate PAT scoped to contents:write on this one repo only — do not
# reuse GITHUB_TOKEN above, which stays read-only.
AUTOFIX_GITHUB_TOKEN=
AUTOFIX_GITHUB_OWNER=UFIConnect
AUTOFIX_GITHUB_REPO=UFIConnect
# Optional dedicated token for Decision Foundry frontend commits and mobile
# workflow dispatches. Scope it to this repository with Contents and Actions
# write access. Falls back to AUTOFIX_GITHUB_TOKEN when left blank.
OFFICE_GITHUB_TOKEN=
# Uploads and generated media storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Password reset email. Use your provider's SMTP host and credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# Persistent browser push signing keys; keep the pair stable across deploys.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@uficonnect.org
# All optional — defaults shown are what the code already falls back to.
AUTOFIX_MIN_DISTINCT_SESSIONS=5
AUTOFIX_WINDOW_MS=21600000
AUTOFIX_MAX_PER_DAY=1
AUTOFIX_MAX_PER_WEEK=3
AUTOFIX_VERIFY_WINDOW_MS=900000
AUTOFIX_CHECK_INTERVAL_MS=600000

# Source-controlled analytics and optional device verification.
# A false setting immediately disables the reviewed capability.
SOURCE_ACCESS_ENABLED=true
SOURCE_INTERACTIONS_ENABLED=true
SOURCE_YOUTUBE_SOURCE_ANALYTICS_ENABLED=true
SOURCE_YOUTUBE_CREATOR_ANALYTICS_ENABLED=true
SOURCE_YOUTUBE_SOURCE_MONETIZATION_ENABLED=true
# Experimental local model of native aggregate activity; never source media.
ACTIVITY_LEARNING_ENABLED=true
# Keep disabled until attestation, firmware policy, hardware and recovery are integrated.
UFI_VAULT_ENABLED=false
UFI_VAULT_RP_ID=
UFI_VAULT_ALLOWED_ORIGINS=
