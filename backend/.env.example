# ── Server ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Pipeline/api role split ──────────────────────────────────
# 'api' (default if unset) serves real user traffic and never fetches
# external sources on its own. 'pipeline' runs all the continuous
# background source-fetchers and writes to feed_posts_staging instead of
# feed_posts_cache — see uficonnect-pipeline in render.yaml and the
# SERVICE_ROLE gates throughout backend/index.js (startContinuousWorkers,
# computePersonalizedFeedPool, enqueueSourceRefresh, etc.). Leave unset for
# local dev — same single-process behavior as before this existed.
SERVICE_ROLE=

# ── Auth ─────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-secret

# Optional Auth0 login/API protection.
# Domain format: your-tenant.us.auth0.com (no https://)
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_ISSUER=

# ── Database (optional — omit to use in-memory mock data) ────
# Local:      DATABASE_URL=postgresql://user:password@localhost:5432/uficonnect
# AWS RDS:    DATABASE_URL=postgresql://user:password@your-rds-host.rds.amazonaws.com:5432/uficonnect
DATABASE_URL=

# Optional read-failover target (see db.js: readQuery/initBackupDB). Only
# used by the two hot feed queries, and only once the primary times out or
# errors repeatedly — every write and every other read still requires
# DATABASE_URL. Omit entirely to run with no failover, same as today.
DATABASE_URL_BACKUP=

# Stripe billing. Resume Builder must use an active USD $149.94 recurring
# Price with interval=month and interval_count=6. New purchases use the
# preferred variable; existing subscriptions stay on the Price they bought.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_PRICE_ID_BUSINESS=
STRIPE_RESUME_BUILDER_PRICE_ID=
# Legacy fallback only; leave blank when the preferred variable is set.
STRIPE_PRICE_ID_RESUME_BUILDER=

# ── Content screening ───────────────────────────────────────────────────────
# Public/external feed items go through deterministic URL/spam checks in the
# pipeline. Member-created posts, comments, messages, and cross-posts receive
# a second OpenAI Moderations API check when OPENAI_API_KEY is present.
OPENAI_API_KEY=
CONTENT_SCREENING_OPENAI_MODEL=omni-moderation-latest
CONTENT_SCREENING_TIMEOUT_MS=8000
CONTENT_SCREENING_MAX_CONCURRENT=4
CONTENT_SCREENING_MAX_QUEUED=100
CONTENT_SUBMISSION_RATE_LIMIT=30

# Media Studio video generation uses the same OPENAI_API_KEY above. The
# selected OpenAI project must have access to the configured video model.
VIDEO_GENERATION_OPENAI_MODEL=sora-2
VIDEO_GENERATION_OPENAI_SECONDS=4
VIDEO_GENERATION_OPENAI_SIZE=720x1280
MEDIA_GENERATION_RATE_LIMIT=6
# Optional long-form provider. It receives POST {prompt, durationSeconds,
# duration} and responds synchronously with {mediaUrl} or {url}. OpenAI's
# native video API supports 4, 8, or 12-second clips; this provider handles
# longer requests up to 300 seconds.
VIDEO_GENERATION_API_URL=
VIDEO_GENERATION_API_KEY=

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins (leave empty to allow all)
ALLOWED_ORIGINS=http://localhost:5173

# ── Public URL bases used for OAuth redirects ────────────────────────────────
# Local:
API_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
# Production:
# API_BASE_URL=https://uficonnect-api-708r.onrender.com
# FRONTEND_URL=https://uficonnect.org

# ── Platform OAuth app credentials ───────────────────────────────────────────
# Add the callback URL shown by /auth/social/config to each provider app.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Separate from the OAuth pair above — a free, self-serve Data API v3 key
# (console.cloud.google.com > APIs & Services > Credentials, no app review
# needed). Without it, YouTube fetching falls back to channel RSS + Invidious
# (see TOPIC_YT_CHANNELS), which works but can't search by keyword or detect
# Shorts (RSS has no duration field to filter on).
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
MEDIUM_CLIENT_ID=
MEDIUM_CLIENT_SECRET=
DRIBBBLE_CLIENT_ID=
DRIBBBLE_CLIENT_SECRET=
BEHANCE_CLIENT_ID=
BEHANCE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
BLUESKY_CLIENT_ID=
BLUESKY_CLIENT_SECRET=

# ── Office dashboard: Deploy Center ──────────────────────────────────────────
# Already read directly via process.env — undocumented here until now. Either
# the three hook URLs (Render service → Settings → Deploy Hook) or the API
# key + service ids make the "Deploy Now" buttons work; auto-deploy-on-push
# to main works regardless of any of these being set.
RENDER_HOOK_API=
RENDER_HOOK_WEB=
RENDER_HOOK_OFFICE=
RENDER_API_KEY=
RENDER_SERVICE_API_ID=
RENDER_SERVICE_WEB_ID=
RENDER_SERVICE_OFFICE_ID=
# Read-only, used for repo search/commits/issues (see GITHUB_HEADERS) —
# separate from AUTOFIX_GITHUB_TOKEN below, which needs write access.
GITHUB_TOKEN=

# ── Office dashboard: Autofix agent ──────────────────────────────────────────
# Detects a recurring server error from real usage, drafts a narrow fix, and
# — only when enabled — commits it via GitHub, letting Render's existing
# auto-deploy-on-push ship it, with an automatic revert if health regresses
# afterward. Off by default; see office/src Autofix view. Detection/logging
# always run regardless of AUTOFIX_ENABLED — only committing a fix is gated.
AUTOFIX_ENABLED=false
# A NEW, separate PAT scoped to contents:write on this one repo only — do not
# reuse GITHUB_TOKEN above, which stays read-only.
AUTOFIX_GITHUB_TOKEN=
AUTOFIX_GITHUB_OWNER=yosufkaka99-alt
AUTOFIX_GITHUB_REPO=UFConnect
# All optional — defaults shown are what the code already falls back to.
AUTOFIX_MIN_DISTINCT_SESSIONS=5
AUTOFIX_WINDOW_MS=21600000
AUTOFIX_MAX_PER_DAY=1
AUTOFIX_MAX_PER_WEEK=3
AUTOFIX_VERIFY_WINDOW_MS=900000
AUTOFIX_CHECK_INTERVAL_MS=600000
