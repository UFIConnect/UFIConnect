# In development the Vite proxy handles /api → localhost:3000 automatically.
# Only set this for production builds pointing at your AWS backend.
VITE_API_URL=https://uficonnect-api-708r.onrender.com

# Optional GA4 G-F68DRQ6CC5, loaded only after visitor consent. This backend
# document must use a different origin from the frontend. For local API testing:
# VITE_ANALYTICS_BRIDGE_URL=http://localhost:3000/analytics-bridge.html
VITE_ANALYTICS_BRIDGE_URL=https://api.uficonnect.org/analytics-bridge.html

# Optional Auth0 login. These are public SPA values, not client secrets.
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-auth0-spa-client-id
VITE_AUTH0_AUDIENCE=https://uficonnect-api
